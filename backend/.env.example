# ==========================================
# Online Quiz Application - Backend Environment Template
# Copy this to .env for local development or configure in Render Dashboard
# ==========================================

# Port and Network Configuration (Render sets PORT automatically)
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# MongoDB Atlas Connection URI
# Replace with your actual MongoDB Atlas connection string:
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/quiz_db?retryWrites=true&w=majority

# Optional: Specific Database Name if not included in URI
DB_NAME=quiz_db

# JWT Secret Key for Session Authentication (Required in Production)
JWT_SECRET=replace_with_a_long_cryptographically_secure_random_string

# Frontend Client URL for CORS
# Provide your deployed Render Static Site URL (and optional localhost addresses separated by commas)
FRONTEND_URL=https://your-frontend-service.onrender.com

# AI Explanation Microservice URL (FastAPI Python Service)
# Point to your deployed Render AI Web Service or leave default if unused
AI_SERVICE_URL=https://your-ai-service.onrender.com

# Administrator Account Initial Seed Configuration
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMeSecurely123!
